# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database bersama (Supabase) agar data terbaca dari semua perangkat.
# Project -> Settings -> API. Service role key HANYA untuk server, jangan dikirim ke frontend.
SUPABASE_URL="https://XXXX.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXX"

# CORS: origin frontend yang diizinkan memanggil API (mis. https://app.vercel.app).
# Kosongkan untuk mengikuti origin pengunjung.
CORS_ORIGIN=""

# Frontend (Vite build): endpoint API tempat frontend memanggil backend.
# KOSONGKAN bila backend berjalan serverless di Vercel SAMA domain dengan frontend (same-origin).
# Hanya diisi bila backend di host terpisah (mis. VPS/VPS PAAS): https://BACKEND.example.com
VITE_API_BASE_URL=""

# Zona waktu penjadwalan cron WA (default Asia/Jakarta). Nilai offset tidak didukung, gunakan nama IANA.
CRON_TIMEZONE="Asia/Jakarta"

# Opsional: token untuk mengamankan endpoint /api/cron-tick (dikirim sbg header Authorization: Bearer <token>).
# Dapat dikosongkan — endpoint hanya menjalankan job yang jatuh tempo, aman dipanggil berulang.
CRON_TICK_TOKEN=""
